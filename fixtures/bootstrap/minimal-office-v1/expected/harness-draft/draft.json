    "NODE_FIELD_REQUIRES_CONFIRMATION",
    "COMPLETION_CONDITION_REQUIRES_HUMAN_CONFIRMATION",
    "FAILURE_HANDLING_REQUIRES_HUMAN_CONFIRMATION"
  ],
  "organization_values_are_references": true
}
