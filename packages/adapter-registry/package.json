{
  "name": "@agent-harness/adapter-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@agent-harness/evidence-importer": "workspace:*",
    "@agent-harness/profile": "workspace:*"
  },
  "scripts": {
    "prebuild": "pnpm --config.engine-strict=false --filter @agent-harness/evidence-importer build && pnpm --config.engine-strict=false --filter @agent-harness/profile build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --config.engine-strict=false --filter @agent-harness/evidence-importer build && pnpm --config.engine-strict=false --filter @agent-harness/profile build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --config.engine-strict=false --filter @agent-harness/evidence-importer build && pnpm --config.engine-strict=false --filter @agent-harness/profile build",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
