{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:bootstrap-storage:v1",
  "title": "Bootstrap storage reference",
  "description": "Stable metadata for an immutable Catalog or Bootstrap Run Manifest stored by a Storage Port.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "ref",
    "contract_id",
    "version",
    "sha256",
    "tenant_ref",
    "classification_level",
    "masking_state"
  ],
  "properties": {
    "kind": { "enum": ["catalog", "run_manifest"] },
    "ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "contract_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "version": { "$ref": "urn:agent-harness-reference:semver:v1" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tenant_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "classification_level": { "type": "string", "minLength": 1, "maxLength": 128 },
    "masking_state": {
      "enum": ["unmasked", "masked", "partially_masked", "unknown"]
    }
  }
}
