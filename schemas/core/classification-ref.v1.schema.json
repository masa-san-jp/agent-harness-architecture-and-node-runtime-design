{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:classification-ref:v1",
  "title": "Data classification reference",
  "description": "An organization-defined classification level with portable tags.",
  "type": "object",
  "additionalProperties": false,
  "required": ["level"],
  "properties": {
    "level": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true
    }
  }
}
