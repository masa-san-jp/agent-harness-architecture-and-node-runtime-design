{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:review-decision:v1",
  "title": "Review decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "target_refs",
    "responder_ref",
    "answer_type",
    "answer",
    "evidence_refs",
    "decided_at"
  ],
  "properties": {
    "decision_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "target_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "responder_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "answer_type": { "enum": ["fact", "opinion", "approval", "exception"] },
    "answer": {},
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "decided_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
