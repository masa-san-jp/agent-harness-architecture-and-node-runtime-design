{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:change-set:v1",
  "title": "Review change set",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_set_id", "base_ref", "changes", "created_by", "created_at", "status"],
  "properties": {
    "change_set_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "base_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "operation", "value", "decision_refs"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["add", "replace", "remove"] },
          "value": {},
          "decision_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
          }
        }
      }
    },
    "created_by": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["proposed", "approved", "rejected", "applied"] },
    "resulting_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
  }
}
