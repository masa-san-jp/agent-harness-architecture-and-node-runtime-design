{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:harness-draft:v1",
  "title": "Non-executable HarnessDraft",
  "description": "A proposed harness shape that cannot execute by construction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft_id",
    "node_ref",
    "draft_version",
    "target_mode",
    "executable",
    "field_proposals",
    "capabilities",
    "permissions",
    "completion_check",
    "failure_handling",
    "logging",
    "teardown",
    "risk",
    "evidence_refs"
  ],
  "properties": {
    "draft_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "node_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "draft_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "target_mode": { "enum": ["observe", "replay", "shadow", "assist", "execute"] },
    "executable": { "const": false },
    "inference_run_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "field_proposals": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "status", "confidence", "evidence_refs", "source"],
        "properties": {
          "field": {
            "enum": ["purpose", "input", "process", "output", "completion_condition", "executor"]
          },
          "value": {},
          "status": {
            "enum": ["fact", "inferred", "human_confirmed", "contradictory", "unverified"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
          },
          "source": { "enum": ["deterministic", "model", "human"] }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_requirements", "skill_refs", "tool_refs", "adapter_bindings"],
      "properties": {
        "model_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "skill_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
        },
        "tool_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
        },
        "adapter_bindings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["binding_ref", "purpose"],
            "properties": {
              "binding_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_scopes", "write_scopes", "network"],
      "properties": {
        "read_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
        },
        "write_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
        },
        "network": { "enum": ["none", "internal", "external"] }
      }
    },
    "input_contract_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "output_contract_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "completion_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status", "verification_method", "evidence_refs"],
      "properties": {
        "value": {},
        "status": { "enum": ["unconfirmed", "candidate", "human_confirmed"] },
        "verification_method": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
        }
      }
    },
    "failure_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "on_failure", "max_retries"],
      "properties": {
        "status": { "enum": ["unconfirmed", "candidate", "human_confirmed"] },
        "on_failure": { "enum": ["stop", "return_to_review", "retry"] },
        "max_retries": { "type": "integer", "minimum": 0 }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_events"],
      "properties": {
        "required_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "teardown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoke_credentials", "delete_workspace"],
      "properties": {
        "revoke_credentials": { "const": true },
        "delete_workspace": { "const": true }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": { "enum": ["low", "medium", "high", "critical"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "profile_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "policy_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "extensions": {
      "type": "object",
      "patternProperties": { "^(domain|local)\\.[a-z][a-z0-9_.-]*$": {} },
      "additionalProperties": false
    }
  }
}
