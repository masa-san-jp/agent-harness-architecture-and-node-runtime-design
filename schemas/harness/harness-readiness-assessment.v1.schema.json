{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:harness-readiness-assessment:v1",
  "title": "HarnessDraft readiness assessment",
  "description": "Deterministic assessment of whether a non-executable draft can enter review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment_id",
    "draft_ref",
    "evaluated_at",
    "status",
    "checks",
    "blocking_reasons"
  ],
  "properties": {
    "assessment_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "draft_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["blocked", "needs_review", "ready_for_approval"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed", "reason"],
        "properties": {
          "check_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
          "passed": { "type": "boolean" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
