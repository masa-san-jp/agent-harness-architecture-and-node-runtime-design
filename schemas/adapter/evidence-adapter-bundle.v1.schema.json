{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:evidence-adapter-bundle:v1",
  "title": "Trusted local evidence adapter bundle",
  "description": "A manifest binding read-only EvidenceAdapter implementations to profile adapter references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_id", "version", "adapters"],
  "properties": {
    "bundle_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "version": { "$ref": "urn:agent-harness-reference:semver:v1" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_ref", "version", "source_kind", "module_path", "read_only"],
        "properties": {
          "adapter_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
          "version": { "$ref": "urn:agent-harness-reference:semver:v1" },
          "source_kind": {
            "enum": [
              "csv",
              "email",
              "chat",
              "file_update",
              "api_audit",
              "procedure",
              "spreadsheet",
              "other"
            ]
          },
          "module_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+\\.mjs$"
          },
          "read_only": { "const": true }
        }
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(domain|local)\\.[a-z][a-z0-9_.-]*$": {}
      },
      "additionalProperties": false
    }
  }
}
