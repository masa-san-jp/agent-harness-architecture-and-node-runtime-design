{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:candidate-edge:v1",
  "title": "Candidate business edge",
  "description": "A reviewable relation between candidate nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge_id",
    "from_node_ref",
    "to_node_ref",
    "status",
    "confidence",
    "evidence_refs",
    "provenance",
    "inference_run_ref",
    "source"
  ],
  "properties": {
    "edge_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "from_node_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "to_node_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "status": { "enum": ["fact", "inferred", "human_confirmed", "contradictory", "unverified"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:agent-harness-reference:provenance:v1" }
    },
    "inference_run_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "source": { "enum": ["deterministic", "model", "human"] },
    "extensions": {
      "type": "object",
      "patternProperties": { "^(domain|local)\\.[a-z][a-z0-9_.-]*$": {} },
      "additionalProperties": false
    }
  }
}
