{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness-reference:inference-run:v1",
  "title": "Graph inference run",
  "description": "Reproducibility metadata for one candidate graph inference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "input_refs",
    "method",
    "configuration_ref",
    "input_digest",
    "executed_at",
    "reproducible",
    "produced_node_refs",
    "produced_edge_refs"
  ],
  "properties": {
    "run_id": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "method": { "enum": ["deterministic", "model", "hybrid"] },
    "configuration_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "input_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "model_version": { "type": "string", "maxLength": 128 },
    "policy_ref": { "$ref": "urn:agent-harness-reference:identifier:v1" },
    "executed_at": { "type": "string", "format": "date-time" },
    "reproducible": { "type": "boolean" },
    "produced_node_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    },
    "produced_edge_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:agent-harness-reference:identifier:v1" }
    }
  }
}
